{
  "name": "jean",
  "version": "0.8.0",
  "private": true,
  "description": "Create with any AI, keep everything. Ask in words or with a file, and get back what you asked for, made. Use GPT, Claude, Gemini or an AI on your computer; your history, files and memory stay on your device. Free and open source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jean-is/jean.git"
  },
  "type": "module",
  "imports": {
    "#prosemirror": "./scripts/prosemirror.js"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.js --gateway --share --home",
    "dev:gateway": "npm run build && node scripts/serve.js --gateway",
    "dev:share": "npm run build && node scripts/serve.js --share",
    "dev:home": "npm run build && node scripts/serve.js --home",
    "start": "npm run build && node scripts/serve.js --budgets",
    "build": "npm run vendor && npm run manifest",
    "build:web": "npm run build && node scripts/web.js",
    "deploy": "node scripts/deploy.js",
    "release": "node scripts/release.js",
    "tenant": "node scripts/tenant.js",
    "render": "npm run build && node scripts/render.js",
    "host": "npm run build && node scripts/host.js",
    "sounds": "node scripts/sounds.js",
    "build:desktop": "npm run build && node scripts/desktop.js",
    "build:dmg": "npm run build && node scripts/desktop.js dmg",
    "cli": "node scripts/cli.js",
    "serve": "node scripts/serve.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "vendor": "node scripts/vendor.js",
    "manifest": "node scripts/manifest.js",
    "icons": "node scripts/icons.js",
    "screenshots": "npm run build && node scripts/screenshots.js",
    "budgets": "node scripts/budgets.js",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run vendor && npm run manifest && npm run typecheck && npm test && npm run budgets",
    "e2e": "playwright test -c test",
    "reflexes": "node scripts/reflexes.js",
    "offers": "npm run build && node scripts/offers.js",
    "tables": "node scripts/tables.js",
    "designs": "node scripts/designs.js",
    "tutor": "npm run build && node scripts/tutor.js",
    "games": "npm run build && node scripts/games.js",
    "concepts": "node scripts/concepts.js",
    "documents": "node scripts/documents.js",
    "longtasks": "node scripts/longtasks.js",
    "directory": "node scripts/directory.js",
    "csp": "node scripts/csp.js"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.5",
    "lit-html": "^3.3.3",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.8.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@babylonjs/core": "^9.32.1",
    "@codename/deck": "^0.5.0",
    "@huggingface/transformers": "^4.3.2",
    "@jean-is/sounds": "^1.0.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@silurus/ooxml": "^0.89.6",
    "abcjs": "^6.7.2",
    "buffer": "^6.0.3",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "just-bash": "3.6.0",
    "lean-qr": "^2.7.4",
    "maplibre-gl": "^6.16.0",
    "mediabunny": "^1.63.0",
    "pdfjs-dist": "^6.4.299",
    "pele": "^1.12.0",
    "phaser": "^4.2.1",
    "pptxgenjs": "4.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "pyodide": "^314.0.7",
    "quickjs-emscripten-core": "^0.32.0",
    "spessasynth_core": "^4.4.2",
    "stb-vorbis": "^0.0.6",
    "temml": "^0.14.0",
    "zzfx": "^1.4.0"
  },
  "overrides": {
    "just-bash@3.6.0": {
      "guarded-fetch": "0.2.0"
    },
    "pptxgenjs@4.0.1": {
      "image-size": "2.0.4"
    }
  }
}
