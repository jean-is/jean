{
  "name": "jean",
  "version": "0.8.0",
  "private": true,
  "description": "An AI agent that runs in a browser tab. Nothing to install, no account, your files never leave your machine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.js --budgets",
    "dev:gateway": "npm run build && node scripts/serve.js --gateway --budgets",
    "start": "npm run build && node scripts/serve.js --budgets",
    "build": "npm run vendor && npm run manifest",
    "build:desktop": "npm run build && node scripts/desktop.js",
    "build:dmg": "npm run build && node scripts/desktop.js dmg",
    "cli": "node scripts/cli.js",
    "serve": "node scripts/serve.js",
    "test": "node --test test/*.test.js",
    "vendor": "node scripts/vendor.js",
    "manifest": "node scripts/manifest.js",
    "icons": "node scripts/icons.js",
    "screenshots": "npm run build && node scripts/screenshots.js",
    "budgets": "node scripts/budgets.js",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run vendor && npm run manifest && npm run typecheck && npm test && npm run budgets",
    "e2e": "playwright test -c test",
    "reflexes": "node scripts/reflexes.js",
    "offers": "npm run build && node scripts/offers.js",
    "concepts": "node scripts/concepts.js",
    "documents": "node scripts/documents.js",
    "directory": "node scripts/directory.js"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "lit-html": "^3.3.3",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@silurus/ooxml": "0.88.0",
    "abcjs": "6.7.1",
    "buffer": "6.0.3",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "just-bash": "3.6.0",
    "maplibre-gl": "6.14.0",
    "pdfjs-dist": "6.4.299",
    "pyodide": "314.0.7",
    "quickjs-emscripten-core": "0.32.0",
    "temml": "0.13.5"
  },
  "overrides": {
    "just-bash@3.6.0": {
      "guarded-fetch": "0.1.5"
    }
  }
}
