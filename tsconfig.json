{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "ES2025.Intl", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/brand.js", "app/core/**/*.js", "app/core/**/*.d.ts", "app/ui/**/*.js", "app/caps/**/*.js", "app/ee/**/*.js", "site/watch/reel.js", "site/watch/schedule.js", "site/watch/score.js", "gateway/gateway.js", "host/host.js", "relay/relay.js", "relay/store.js", "requests/requests.js"],
  "exclude": ["app/ee/verify.js", "app/ee/mask-worker.js", "app/ui/*-worker.js", "app/caps/**/*-worker.js", "app/caps/**/*-worklet.js", "node_modules", "app/vendor"]
}
