{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["brand.js", "core/**/*.js", "core/**/*.d.ts", "ui/**/*.js", "caps/**/*.js"],
  "exclude": ["ui/*-worker.js", "caps/**/*-worker.js", "caps/**/*-worklet.js", "node_modules", "vendor"]
}
