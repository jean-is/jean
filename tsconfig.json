{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "ES2025.Intl", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/brand.js", "app/core/**/*.js", "app/core/**/*.d.ts", "app/ui/**/*.js", "app/caps/**/*.js", "app/ee/**/*.js", "gateway/gateway.js", "host/host.js", "requests/requests.js"],
  "exclude": ["app/ui/*-worker.js", "app/caps/**/*-worker.js", "app/caps/**/*-worklet.js", "node_modules", "app/vendor"]
}
