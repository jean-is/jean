<?xml version="1.0" encoding="utf-8"?>
<!-- Jean on IIS: the header set, the types and the pages without .html of deploy/README.md. Copied
     into dist/web/ before it is copied to the site's folder (README.md beside this file). Pages
     without .html need the URL Rewrite module. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <staticContent>
      <!-- Cache-Control: no-cache, with the ETag and Last-Modified IIS sends to check it. -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".html" /><mimeMap fileExtension=".html" mimeType="text/html; charset=utf-8" />
      <remove fileExtension=".js" /><mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".mjs" /><mimeMap fileExtension=".mjs" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".css" /><mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".wasm" /><mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".png" /><mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".jpg" /><mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" /><mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".txt" /><mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".md" /><mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <remove fileExtension=".csv" /><mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
      <remove fileExtension=".xml" /><mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".zip" /><mimeMap fileExtension=".zip" mimeType="application/zip" />
      <remove fileExtension=".bcmap" /><mimeMap fileExtension=".bcmap" mimeType="application/octet-stream" />
      <remove fileExtension=".pfb" /><mimeMap fileExtension=".pfb" mimeType="application/octet-stream" />
      <remove fileExtension=".sf3" /><mimeMap fileExtension=".sf3" mimeType="application/octet-stream" />
      <!-- A file without an ending: LICENSE. -->
      <remove fileExtension="." /><mimeMap fileExtension="." mimeType="text/plain; charset=utf-8" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- The organisation's own policy goes here too, after a semicolon: it can only take away. -->
        <add name="Content-Security-Policy" value="frame-ancestors 'self'" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

    <!-- Compressed as it is served, gzip, or brotli with Microsoft's IIS Compression; the types to
         compress are the server's (README.md). -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <rewrite>
      <rules>
        <rule name="Pages without .html" stopProcessing="true">
          <match url="^(privacy|terms|files)$" />
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
