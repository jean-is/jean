# Jean's services on their own server (README.md beside this file). Caddy holds ports 80 and 443: each name gets its
# certificate from Let's Encrypt alone, plain HTTP is sent on to HTTPS, and nothing is logged.
{
	log default {
		output discard
	}
	cert_issuer acme
	on_demand_tls {
		ask http://127.0.0.1:8790/
	}
}

# No cookie of any kind (D725): one a service's answer would carry is dropped before it leaves.
(no-cookies) {
	header -Set-Cookie
}

# The gateway, for the services a browser can't reach (D191, D344).
gateway.jean.is {
	import no-cookies
	reverse_proxy gateway:8787
}

# The share host (D361), told the visitor's port beside the address it takes from Caddy (HOST_PROXIED): shares under /s/, the
# root for the host's own page and the links made before. Published sites (D720) are Bunny's, never this server's.
hst.ing {
	import no-cookies
	reverse_proxy share:8788 {
		header_up X-Client-Port {remote_port}
	}
}

www.hst.ing {
	redir https://hst.ing{uri} permanent
}

# The relay (D45 · D226), told the visitor's port beside the address it takes from Caddy (RELAY_PROXIED).
relay.jean.is {
	import no-cookies
	reverse_proxy relay:8791 {
		header_up X-Client-Port {remote_port}
		# A journal's stream (relay/journal.js) reaches its readers line by line.
		flush_interval -1
	}
}

# Where the page for a key sends.
keys.jean.is {
	import no-cookies
	reverse_proxy requests:8789
}

# The hosted copies (D456): the ask site and a site for each address, as npm run tenant writes them.
import /srv/hosted/tenants/Caddyfile
