{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jean",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "jean-gateway",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.js",
        "--gateway"
      ],
      "port": 4373,
      "env": {
        "PORT": "4373"
      }
    },
    {
      "name": "jean-share",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.js",
        "--share"
      ],
      "port": 4473,
      "env": {
        "PORT": "4473",
        "SHARE_PORT": "4474"
      }
    },
    {
      "name": "fake-brain",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "test/fixtures/fake-brain.js"
      ],
      "port": 4174
    },
    {
      "name": "fake-mail",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "test/fixtures/fake-mail.js"
      ],
      "port": 4182
    }
  ]
}
